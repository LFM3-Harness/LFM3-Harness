{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LFM3 Workspace",
  "version": "0.1.1",
  "identifier": "dev.lfm3.workspace",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui run dev -- --host 127.0.0.1 --port 1420",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node ../../scripts/stage-llama-runtime.mjs && npm --prefix ../ui run build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LFM3 Workspace",
        "width": 1280,
        "height": 1000,
        "minWidth": 960,
        "minHeight": 720,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420 http://127.0.0.1:1420; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": {
      "../../../missions": "missions",
      "resources/llama": "tools/llama"
    }
  }
}
