# Local paths and execution limits for the Rust LFM3 harness.
# Values are planned interfaces until the Rust configuration module is implemented.

# --- workspace and trusted state --------------------------------------
# LFM3_WORKSPACE=F:\work\scratch
# Defaults to %LOCALAPPDATA%\LFM3Harness when unset.
# LFM3_DATA_DIR=%LOCALAPPDATA%\LFM3Harness

# --- hardware profile -------------------------------------------------
# cpu -> llama.cpp runs with -ngl 0 on all threads (default)
# gpu -> llama.cpp offloads every layer (-ngl 99)
LFM3_PROFILE=cpu
# LFM3_THREADS=8
# LFM3_NGL=0
# LFM3_CTX_TEXT=6144
# LFM3_CTX_VISION=4096
# LFM3_CTX_AUDIO=4096
# LFM3_CTX_D1=16384

# --- memory and ownership ---------------------------------------------
# 0 = 70% of physical RAM.
# LFM3_RAM_BUDGET_MB=8000
# Packaged runs must not download weights.
LFM3_ALLOW_DOWNLOAD=0
# Packaged runs own their model processes. Development reuse is explicit.
LFM3_REUSE_EXTERNAL_SERVERS=0
# LFM3_SERVER_TIMEOUT=240

# --- local model endpoints --------------------------------------------
# Packaged mode rejects non-loopback hosts.
LFM3_TEXT_URL=http://127.0.0.1:8080/v1
LFM3_TEXT_MODEL=lfm3-1.7b
LFM3_VISION_URL=http://127.0.0.1:8081/v1
LFM3_VISION_MODEL=lfm3-vl-2b
LFM3_AUDIO_URL=http://127.0.0.1:8082/v1
LFM3_AUDIO_MODEL=lfm3-audio-2b
LFM3_D1_URL=http://127.0.0.1:8083/v1
LFM3_D1_MODEL=d1-2b

# --- speech and calibrated decisions ----------------------------------
# LFM3_TTS_VOICE=female
# LFM3_TTS_LANG=en
# LFM3_USE_D1=1

# --- pinned llama.cpp binaries ----------------------------------------
# LFM3_LLAMA_SERVER=C:\tools\llama.cpp\llama-server.exe
# LFM3_LLAMA_TTS=C:\tools\llama.cpp\llama-tts.exe
# LLAMA_CACHE=F:\lfm3\models

# --- finite run limits -------------------------------------------------
# LFM3_MAX_STEPS=8
# LFM3_MAX_ATTEMPTS_PER_STRATEGY=3
# LFM3_MAX_STRATEGIES=2
# LFM3_MAX_TOTAL_ATTEMPTS=6
# LFM3_RUN_TIMEOUT_SECONDS=900
# LFM3_MAX_TOKENS=4096
# LFM3_TEMPERATURE=0.1
# LFM3_SHELL_TIMEOUT=120
# LFM3_CONTEXT_CHARS=18000
